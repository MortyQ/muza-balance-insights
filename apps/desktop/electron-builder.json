{
  "appId": "io.github.mortyq.balanceinsights",
  "productName": "Balance Insights",
  "directories": {
    "output": "dist"
  },
  "files": [
    "out/**",
    "package.json",
    "!**/*.map",
    "!node_modules/pdfjs-dist/{build,web,image_decoders,types,wasm,iccs,cmaps,standard_fonts}/**",
    "!node_modules/pdfjs-dist/legacy/{web,image_decoders}/**",
    "!node_modules/pdfjs-dist/{,legacy/}webpack.mjs",
    "!node_modules/pdfjs-dist/legacy/build/{pdf.min.mjs,pdf.worker.min.mjs,pdf.sandbox.mjs,pdf.sandbox.min.mjs}"
  ],
  "asar": true,
  "asarUnpack": [
    "**/*.node"
  ],
  "npmRebuild": false,
  "electronDownload": {
    "cache": "node_modules/.cache/electron"
  },
  "publish": {
    "provider": "github",
    "owner": "MortyQ",
    "repo": "muza-balance-insights",
    "releaseType": "draft"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64",
          "x64"
        ]
      }
    ],
    "identity": null,
    "category": "public.app-category.finance",
    "artifactName": "Balance-Insights-${version}-mac-${arch}.${ext}"
  },
  "dmg": {
    "sign": false,
    "writeUpdateInfo": false
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "Balance-Insights-${version}-win-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "deleteAppDataOnUninstall": false,
    "differentialPackage": false
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      }
    ],
    "executableName": "balance-insights",
    "category": "Finance",
    "artifactName": "Balance-Insights-${version}-linux-${arch}.${ext}"
  },
  "electronFuses": {
    "runAsNode": false,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "grantFileProtocolExtraPrivileges": false,
    "enableCookieEncryption": false,
    "loadBrowserProcessSpecificV8Snapshot": false,
    "resetAdHocDarwinSignature": true
  }
}
