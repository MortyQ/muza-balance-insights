      "Bash(hexdump *)", "Bash(npm run sync)", "Bash(npm run sync *)", "Bash(pnpm sync)", "Bash(pnpm sync *)",
      "Bash(pnpm * sync)", "Bash(pnpm * sync *)", "Bash(npm run accounts)", "Bash(npm run accounts *)",
      "Bash(pnpm accounts)", "Bash(pnpm accounts *)", "Bash(pnpm * accounts)", "Bash(pnpm * accounts *)",
      "Bash(npm run dev:mcp)", "Bash(npm run dev:mcp *)", "Bash(pnpm dev:mcp)", "Bash(pnpm dev:mcp *)",
      "Bash(pnpm * dev:mcp)", "Bash(pnpm * dev:mcp *)", "Bash(npm run recategorize)",
      "Bash(npm run recategorize *)", "Bash(pnpm recategorize)", "Bash(pnpm recategorize *)",
      "Bash(pnpm * recategorize *)", "Bash(npm run overrides:*)", "Bash(pnpm overrides:*)",
      "Bash(pnpm * overrides:*)", "Bash(npm run scope-overrides:*)", "Bash(pnpm scope-overrides:*)",
      "Bash(pnpm * scope-overrides:*)", "Bash(npm run settings:*)", "Bash(pnpm settings:*)",
      "Bash(pnpm * settings:*)", "Bash(npm run export:analysis)", "Bash(npm run export:analysis *)",
      "Bash(pnpm export:analysis)", "Bash(pnpm export:analysis *)", "Bash(pnpm * export:analysis)",
      "Bash(pnpm * export:analysis *)", "Bash(npm run verify:merchants)", "Bash(npm run verify:merchants *)",
      "Bash(pnpm verify:merchants)", "Bash(pnpm verify:merchants *)", "Bash(pnpm * verify:merchants)",
      "Bash(pnpm * verify:merchants *)", "Bash(*tsx *src/cli/*)", "Bash(*tsx *src/server.ts*)",
      "Bash(node *src/cli/*)", "Bash(node *src/server.ts*)", "Bash(*tsx *scripts/overrides*)",
      "Bash(*tsx *scripts/scope-overrides*)", "Bash(*tsx *scripts/settings*)",
      "Bash(*tsx *scripts/export-analysis*)", "Bash(*tsx *scripts/verify-merchants*)",
