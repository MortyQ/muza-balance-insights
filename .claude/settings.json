  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "pnpm --filter @mono/mcp recategorize",
      "git add",
      "git commit"
    ],
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.*",
        "./**/.env",
        "./**/.env.*",
        "./data",
        "./**/*.db",
        "./**/*.db-*",
        "~/Library/Application Support/Balans Insights",
        "~/Library/Caches/Balans Insights",
        "~/Library/Logs/Balans Insights",
        "~/Library/Application Support/Balans Insights Dev",
        "~/Library/Caches/Balans Insights Dev",
        "~/Library/Logs/Balans Insights Dev",
        "~/Library/Application Support/Balance Insights",
        "~/Library/Caches/Balance Insights",
        "~/Library/Logs/Balance Insights",
        "~/Library/Application Support/Balance Insights Dev",
        "~/Library/Caches/Balance Insights Dev",
        "~/Library/Logs/Balance Insights Dev",
        "~/Library/Application Support/Electron",
        "~/Library/Caches/Electron",
        "~/Library/Logs/Electron",
        "~/Library/Application Support/@mono/desktop",
        "~/Library/Caches/@mono/desktop",
        "~/Library/Logs/@mono/desktop"
      ]
    }
