      "Read(~/Library/Application Support/Balans Insights/**)",
      "Edit(~/Library/Application Support/Balans Insights/**)", "Read(~/Library/Caches/Balans Insights/**)",
      "Edit(~/Library/Caches/Balans Insights/**)", "Read(~/Library/Logs/Balans Insights/**)",
      "Edit(~/Library/Logs/Balans Insights/**)", "Read(~/Library/Application Support/Balans Insights Dev/**)",
      "Edit(~/Library/Application Support/Balans Insights Dev/**)", "Read(~/Library/Caches/Balans Insights Dev/**)",
      "Edit(~/Library/Caches/Balans Insights Dev/**)", "Read(~/Library/Logs/Balans Insights Dev/**)",
      "Edit(~/Library/Logs/Balans Insights Dev/**)",
      "Read(~/Library/Application Support/Balance Insights/**)", "Edit(~/Library/Application Support/Balance Insights/**)",
      "Read(~/Library/Application Support/Balance Insights Dev/**)", "Edit(~/Library/Application Support/Balance Insights Dev/**)",
      "Read(~/Library/Caches/Balance Insights/**)", "Edit(~/Library/Caches/Balance Insights/**)",
      "Read(~/Library/Caches/Balance Insights Dev/**)", "Edit(~/Library/Caches/Balance Insights Dev/**)",
      "Read(~/Library/Logs/Balance Insights/**)", "Edit(~/Library/Logs/Balance Insights/**)",
      "Read(~/Library/Logs/Balance Insights Dev/**)", "Edit(~/Library/Logs/Balance Insights Dev/**)", "Read(~/Library/Application Support/Electron/**)",
      "Edit(~/Library/Application Support/Electron/**)", "Read(~/Library/Caches/Electron/**)",
      "Edit(~/Library/Caches/Electron/**)", "Read(~/Library/Logs/Electron/**)", "Edit(~/Library/Logs/Electron/**)",
      "Read(~/Library/Application Support/@mono/desktop/**)",
      "Edit(~/Library/Application Support/@mono/desktop/**)", "Read(~/Library/Caches/@mono/desktop/**)",
      "Edit(~/Library/Caches/@mono/desktop/**)", "Read(~/Library/Logs/@mono/desktop/**)",
      "Edit(~/Library/Logs/@mono/desktop/**)", "Bash(pnpm * dev)", "Bash(pnpm * dev *)", "Bash(pnpm dev)",
      "Bash(pnpm dev *)", "Bash(pnpm * preview)", "Bash(pnpm * preview *)", "Bash(*electron-vite*)",
      "Bash(*electron *)", "Bash(*electron)", "Bash(*Electron.app*)", "Bash(*Balans Insights*)", "Bash(*Balance Insights*)"
